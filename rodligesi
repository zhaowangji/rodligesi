function [dis]=get_dis(point1,point2)
    t1=point1(1,1)-point2(1,1);
    t2=point1(2,1)-point2(2,1);
    t3=point1(3,1)-point2(3,1);
    dis=sqrt(t1*t1+t2*t2+t3*t3);
end

function [theta]=get_angle(line1,line2)
    dpd=dot(line1,line2);
    norm1=norm(line1);
    norm2=norm(line2);
    cos_theta=dpd/(norm1*norm2);
    cos_theta=min(max(cos_theta,-1),1);
    cos_theta=abs(cos_theta);
    theta=acos(cos_theta);
    theta=theta*180/pi;
end

function [angle]=get_angle_i(line1,line2)

    cnt=dot(line1,line2);

    angle=acos(cnt);

end

function [omega]=get_rot_axis(number)
    omega=zeros(number,3);
    phi=(sqrt(5)-1)/2;
    for i=1:number
        z=(2*i-1)/number-1;
        x=sqrt(1-z^2)*cos(2*pi*i*phi);
        y=sqrt(1-z^2)*sin(2*pi*i*phi);
        new_data=[x,y,z];
        omega(i,:)=new_data;
    end
end

function show_sample(omega,number)
    % 2. 创建图形窗口
    figure;
    scatter3(omega(:,1), omega(:,2), omega(:,3), 15, 'filled', 'MarkerFaceColor', '#0072BD');
    
    % 3. 美化图形
    axis equal;      % 保证坐标轴比例一致，否则球体会看起来像椭球
    grid on;         % 显示网格
    xlabel('X');
    ylabel('Y');
    zlabel('Z');
    title(['Spherical Fibonacci Sampling (n = ', num2str(number), ')']);
    
    % 4. 视角调整
    view(3);         % 设置为 3D 视角
end
